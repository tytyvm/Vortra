# Copy to .env and fill in. Never commit .env. Secrets live only in environment variables.

# --- App ---
APP_URL=http://localhost:3000
# SQLite for local dev. For Postgres: postgresql://user:pass@host:5432/vortra (see README)
DATABASE_URL=file:./prisma/dev.db

# --- Model (switch providers/models here, no code changes) ---
# LLM_PROVIDER: mock | openai | anthropic | gemini | xai | openai-compatible
LLM_PROVIDER=mock
LLM_MODEL=
# Set to false if the main model cannot read images (users will be asked to describe meals instead)
LLM_VISION=true

# Optional: a separate (often cheaper) model for daily/weekly recaps
LLM_RECAP_PROVIDER=
LLM_RECAP_MODEL=
# Optional: a separate vision model used only for messages that include a photo
LLM_PHOTO_PROVIDER=
LLM_PHOTO_MODEL=

# Provider keys (only the one(s) you use). LLM_API_KEY is a fallback for any provider.
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
# Optional for Gemini thinking models: cap thinking tokens (0 disables thinking on models that allow it)
GEMINI_THINKING_BUDGET=
XAI_API_KEY=
XAI_BASE_URL=
# Generic OpenAI-compatible server: OpenRouter, Groq, Together, Mistral, DeepSeek, Ollama, LM Studio...
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Set false if your server rejects stream_options.include_usage
OPENAI_COMPATIBLE_STREAM_USAGE=true

# --- Cost controls ---
MAX_OUTPUT_TOKENS=700
MAX_INPUT_TOKENS=12000
HISTORY_MESSAGES=10
MAX_TOOL_ROUNDS=6
USER_MONTHLY_LIMIT_USD=5
APP_DAILY_LIMIT_USD=25
CHAT_RATE_LIMIT_PER_MIN=12
MAX_MESSAGE_CHARS=4000
MAX_IMAGE_BYTES=1500000

# --- Recaps (optional) ---
RECAPS_ENABLED=false
# external: your scheduler calls POST /api/cron/recaps hourly with "Authorization: Bearer $CRON_SECRET"
# internal: the app checks every 15 minutes while running
RECAPS_SCHEDULER=external
RECAP_HOUR=20
RECAPS_EMAIL=false
CRON_SECRET=

# --- Email (magic-link login) ---
# console prints the login link to the server terminal (dev only). resend | postmark for real email.
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# --- Subscriptions (optional, off by default; Stripe is never called when disabled) ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PLAN_FREE_MONTHLY_USD=0.5
PLAN_FREE_PHOTOS=true
PLAN_PRO_MONTHLY_USD=5
